+                raise InvalidRequestError("unknown SKU")
+            if isinstance(quantity, bool) or not isinstance(quantity, int) or quantity <= 0:
+                raise InvalidRequestError("quantities must be positive integers")
+            normalized[sku] = quantity
+        return normalized
 
